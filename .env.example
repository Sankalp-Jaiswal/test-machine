# =============================================================================
# CIL MT PREP ARENA - ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
# Example: https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Your Supabase public API key (safe to expose in client-side code)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your Supabase service role key (KEEP SECRET - server-side only)
# This key has admin privileges and should never be exposed to the client
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# SUPABASE AUTH CONFIGURATION
# =============================================================================
# These are Supabase Auth settings

# Enable/disable email confirmations
# Values: true or false
SUPABASE_AUTH_EMAIL_CONFIRMATION=false

# Session expiry time in seconds (default: 3600 = 1 hour)
SESSION_EXPIRY=3600

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application name
APP_NAME=CIL MT Prep Arena

# Application URL (used for redirects after auth)
# Example: http://localhost:3000 (development) or https://yourdomain.com (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
# Values: development, production, test
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# These values are typically managed by Supabase, but you can override them

# Database Host (provided by Supabase)
# Example: db.YOUR_PROJECT_ID.supabase.co
DB_HOST=your_db_host_here

# Database Port (usually 5432 for PostgreSQL)
DB_PORT=5432

# Database Name (usually postgres)
DB_NAME=postgres

# Database User (provided by Supabase)
# Example: postgres
DB_USER=postgres

# Database Password (provided by Supabase)
DB_PASSWORD=your_db_password_here

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# File upload and storage settings

# Maximum file upload size in MB
MAX_FILE_UPLOAD_SIZE=10

# Allowed file types for test import (comma-separated)
# Supported: json, docx, pdf
ALLOWED_FILE_TYPES=json,docx,pdf

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level
# Values: debug, info, warn, error
LOG_LEVEL=info

# Enable API request logging
# Values: true or false
ENABLE_API_LOGGING=true

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================

# Vercel Analytics Token (if using Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Google Analytics ID (optional)
NEXT_PUBLIC_GA_ID=

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable database storage (if false, uses localStorage only)
ENABLE_DATABASE_STORAGE=true

# Enable file uploads (DOCX/PDF parsing)
ENABLE_FILE_UPLOADS=true

# Enable user authentication
ENABLE_AUTH=true

# Enable test sharing/public tests
ENABLE_TEST_SHARING=true

# =============================================================================
# DEPLOYMENT & HOSTING
# =============================================================================

# Vercel Project ID (if deploying to Vercel)
VERCEL_PROJECT_ID=

# Vercel Team ID (if in a team)
VERCEL_TEAM_ID=

# =============================================================================
# INSTRUCTIONS FOR SETUP
# =============================================================================
# 
# 1. CREATE SUPABASE PROJECT:
#    - Go to https://supabase.com/dashboard
#    - Create a new project
#    - Wait for project initialization
#
# 2. GET YOUR CREDENTIALS:
#    - Go to Settings > API
#    - Copy Project URL -> NEXT_PUBLIC_SUPABASE_URL
#    - Copy Anon Key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - Copy Service Role Key -> SUPABASE_SERVICE_ROLE_KEY
#
# 3. SETUP DATABASE SCHEMA:
#    - Go to SQL Editor in Supabase dashboard
#    - Copy contents of supabase/migrations/init.sql
#    - Paste and run the SQL
#
# 4. CREATE .env.local:
#    - Copy this file to .env.local
#    - Replace all "your_*_here" values with actual values from Supabase
#    - NEVER commit .env.local to version control
#
# 5. START DEVELOPMENT:
#    - Run: npm run dev (or pnpm dev / yarn dev)
#    - Open http://localhost:3000
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# - NEVER commit .env.local to version control
# - NEVER share your SUPABASE_SERVICE_ROLE_KEY
# - Only use NEXT_PUBLIC_* variables for values safe to expose in client
# - Keep secrets in .env.local (local) or use Vercel Secrets (production)
# - For production, use Vercel Environment Variables dashboard
#
# =============================================================================
